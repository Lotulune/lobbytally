# Set these as server-side Environment Variables in the Vercel project.
PORT=8080
# Copy the session-pooler host from Supabase Connect; do not use port 6543.
# Migration 20261018182444 creates this backend role; its password is in Vault
# as lobbytally_database_password. Percent-encode the password for the URL.
MPGS_DATABASE_URL=postgresql://lobbytally_runtime.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
MPGS_SUPABASE_URL=https://PROJECT_REF.supabase.co
MPGS_SUPABASE_SERVICE_ROLE_KEY=
MPGS_SUPABASE_AVATAR_BUCKET=avatars
# Generate an independent random secret with at least 32 non-whitespace bytes.
# Put the same value in Supabase Vault as lobbytally_cron_secret.
MPGS_CRON_SECRET=
MPGS_ADMIN_TOKEN=
MPGS_TRUST_PROXY_HEADERS=true
MPGS_RATE_LIMIT_ENABLED=true
MPGS_AI_PROVIDER=disabled
MPGS_WORKER_BUDGET_SECS=45
MPGS_WORKER_JOB_LIMIT=4
MPGS_WORKER_STAGE_LIMIT=6
MPGS_WORKER_PAGE_LIMIT=1
# Optional: the worker can discover Steam Store candidates without this key.
# MPGS_STEAM_WEB_API_KEY=
# MPGS_STEAM_COUNTRY=CN
# MPGS_STEAM_LANGUAGE=schinese
# Optional built-in AI provider (all credentials remain server-side).
# MPGS_AI_PROVIDER=openai_compat
# MPGS_AI_BASE_URL=https://YOUR_PROVIDER/v1
# MPGS_AI_API_KEY=
# MPGS_AI_MODEL=YOUR_MODEL
