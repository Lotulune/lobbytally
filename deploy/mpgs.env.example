# Copy to deploy/mpgs.env on the VPS. Do not commit the real file.
MPGS_ADMIN_TOKEN=
MPGS_RATE_LIMIT_ENABLED=true
MPGS_TRUST_PROXY_HEADERS=true
MPGS_CORS_ENABLED=true
# Preserve both packaged Tauri origins when adding the optional browser UI.
MPGS_CORS_ALLOWED_ORIGINS=http://tauri.localhost,tauri://localhost,https://mpgs.lunafleur.dpdns.org
MPGS_WORKER_INTERVAL_SECS=60
MPGS_WORKER_JOB_LIMIT=10
MPGS_WORKER_ENRICH_LIMIT=100
MPGS_WORKER_MAX_CONSECUTIVE_FAILURES=5
# Retry transient SQLite/upstream failures sooner than the normal work cadence.
MPGS_WORKER_RETRY_INTERVAL_SECS=30
# A single leased batch exceeding this duration makes the worker unhealthy.
MPGS_WORKER_MAX_RUN_SECS=1800
# Scheduler task cadence (server process). Defaults: catalog 900s, candidates 6h, enrich 300s.
# MPGS_SCHEDULER_INTERVAL_SECS=300
# MPGS_CATALOG_SYNC_INTERVAL_SECS=900
# MPGS_CANDIDATE_COLLECTION_INTERVAL_SECS=21600
# MPGS_ENRICHMENT_INTERVAL_SECS=300
# Bound per-cycle FTS/hash-embedding maintenance on small production hosts.
# MPGS_RETRIEVAL_SYNC_BATCH_SIZE=200
# Bounded continuation pages per released/upcoming discovery channel (default 10).
# MPGS_CANDIDATE_WORKER_PAGES=10
# Catch-up / burst profile (temporary — dial back after the catalog is current):
# MPGS_CATALOG_SYNC_INTERVAL_SECS=60
# MPGS_ENRICHMENT_INTERVAL_SECS=60
# MPGS_WORKER_INTERVAL_SECS=30
# MPGS_WORKER_ENRICH_LIMIT=300
# MPGS_CATALOG_WORKER_PAGES=5
# Prefer store details only while backfilling release dates/calendar (much faster):
# MPGS_ENRICH_STORE_ONLY=true
# MPGS_ENRICH_INTER_REQUEST_MS=1200
# Media gallery backfill (store appdetails re-fetch for missing app_media_assets).
# Only runs when candidate media coverage is below the threshold; bounded per app.
# MPGS_MEDIA_BACKFILL_ENABLED=true
# MPGS_MEDIA_BACKFILL_COVERAGE_THRESHOLD=0.95
# MPGS_MEDIA_BACKFILL_MAX_ATTEMPTS=3
# MPGS_MEDIA_BACKFILL_COOLDOWN_MS=21600000
# Optional: enables the official Steam catalog sync job.
# MPGS_STEAM_WEB_API_KEY=

# Built-in OpenAI-compatible AI gateway (M8 multi-model routing).
# Keep the real key only in deploy/mpgs.env on the server — never in Git or images.
# MPGS_AI_PROVIDER=disabled
# MPGS_AI_BASE_URL=https://example.com/v1
# MPGS_AI_API_KEY=
# Multi-model is ON by default. Set MPGS_AI_MULTI_MODEL=false to collapse
# every online task onto a single MPGS_AI_MODEL (legacy M5 behaviour).
# MPGS_AI_MULTI_MODEL=true
# Provider default / single-model mode only:
# MPGS_AI_MODEL=grok-4.5
# HTTP client timeout for multi-model router (default 45s; must cover longest route).
# Provider-level Timeout still trips the per-model circuit; shared route cancels do not.
# MPGS_AI_TIMEOUT_SECS=45
# Task route overrides (optional; defaults use grok-4.5 primary).
# IntentParse default total chain budget is 12s; each attempt is capped at half
# so a hung primary still leaves room for protocol/model fallback.
# Raise if cold Responses latency is high in your region:
# MPGS_AI_ROUTE_INTENT_PARSE_MODEL=grok-4.5
# MPGS_AI_ROUTE_INTENT_PARSE_FALLBACKS=grok-4.20-0309-non-reasoning,grok-4.3
# MPGS_AI_ROUTE_INTENT_PARSE_TIMEOUT_SECS=15
# MPGS_AI_ROUTE_RANK_EXPLAIN_MODEL=grok-4.5
# MPGS_AI_ROUTE_RANK_EXPLAIN_FALLBACKS=grok-4.20-0309-non-reasoning,grok-4.3
# Embedding: Grok2API has no usable embedding models for MPGS — keep hash.
# MPGS_AI_EMBED_PROVIDER=hash
# MPGS_AI_EMBED_DIMENSIONS=64
