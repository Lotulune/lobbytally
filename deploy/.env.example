MPGS_SERVER_REPOSITORY=ghcr.io/lotulune/mpgs-server
MPGS_WEB_REPOSITORY=ghcr.io/lotulune/mpgs-web
# This pointer moves only after both sha-<commit> images have been published.
MPGS_RELEASE_POINTER_IMAGE=ghcr.io/lotulune/mpgs-server:release-main
# Optional emergency pin/rollback. Leave empty to follow the release pointer.
# MPGS_RELEASE_SHA=
MPGS_DEPLOY_BRANCH=main
# full: API + worker + browser Web UI; backend: API + worker only.
MPGS_DEPLOY_MODE=full
# Loopback port used by the backend-only host reverse proxy.
MPGS_API_PORT=18081
