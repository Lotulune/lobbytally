<!--
  WinSW service definition for mpgs-server.
  packaging/windows/install-service.ps1 copies this template and the binaries
  into a protected installation root, applies the service account/data ACLs,
  and fills the host-specific paths. It intentionally does not start unless
  the administrator passes -Start with a non-empty secure AdminToken.

  Native SCM integration is intentionally delegated to WinSW so the console
  binary stays portable. See docs/OPERATIONS.md and docs/SIGNING_AND_UPDATES.md.
-->
<service>
  <id>mpgs-server</id>
  <name>MPGS Server</name>
  <description>MPGS Steam multiplayer recommendation API (local SQLite authority)</description>
  <executable>%BASE%\..\bin\mpgs-server.exe</executable>
  <workingdirectory>%ProgramData%\MPGS</workingdirectory>
  <serviceaccount>
    <username>NT AUTHORITY\LocalService</username>
  </serviceaccount>
  <env name="MPGS_DATABASE_PATH" value="%ProgramData%\MPGS\data\mpgs.db"/>
  <env name="MPGS_BIND_ADDR" value="127.0.0.1:8080"/>
  <!-- The installer fills this only from a SecureString and protects the XML. -->
  <env name="MPGS_ADMIN_TOKEN" value=""/>
  <logpath>%ProgramData%\MPGS\logs</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
  <onfailure action="restart" delay="5 sec"/>
  <stoptimeout>20 sec</stoptimeout>
  <startmode>Manual</startmode>
</service>
